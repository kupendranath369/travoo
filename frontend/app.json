{
  "expo": {
    "name": "Travoo",
    "slug": "travoo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "travoo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.travoojourneys.vae0fl",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find rides starting near your current location",
        "NSCameraUsageDescription": "Photograph your licence and vehicle for verification",
        "NSPhotoLibraryUsageDescription": "Choose photos of your driving documents"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.emergent.travoojourneys.vae0fl",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F8FC"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find rides starting near your current location"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of your driving documents",
          "cameraPermission": "Photograph your licence and vehicle for verification"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
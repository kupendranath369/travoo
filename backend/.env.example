# Backend runtime settings
MONGO_URL=mongodb://localhost:27017
DB_NAME=travoo
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
FRONTEND_URL=https://your-travoo-web-app.example

# Password reset and transactional email (Resend)
# Verify the sender domain in Resend before using it.
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM=Travoo <no-reply@your-verified-domain.example>
